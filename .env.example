# Copy to .env.local for `vercel dev`, or set these in the Vercel dashboard.
# Every one of them is optional — the site runs without any of them, minus the
# fix plan.

# Server-side Anthropic key. When this is set, no key ever reaches the browser
# and visitors can leave the key field empty.
# WARNING: on a public deployment this spends YOUR tokens for every visitor.
# Leave it unset if you want each visitor to bring their own key.
ANTHROPIC_API_KEY=

# Set to 1 to refuse visitor-supplied keys entirely (server key or nothing).
REQUIRE_SERVER_KEY=

# Model used for the copy review and fix plan.
CLAUDE_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Higher costs more and takes longer; the
# function has a 60s ceiling, so medium is the safe default.
CLAUDE_EFFORT=medium

# Per-IP burst limits for the two endpoints.
CLAUDE_RATE_MAX=10
CLAUDE_RATE_WINDOW_MS=60000
PROXY_RATE_MAX=120
PROXY_RATE_WINDOW_MS=60000

# Lock the API endpoints to one origin instead of allowing any.
# e.g. https://webtesting.vercel.app
ALLOWED_ORIGIN=

# Sent as the crawler's User-Agent so site owners can identify the traffic.
PROXY_USER_AGENT=
